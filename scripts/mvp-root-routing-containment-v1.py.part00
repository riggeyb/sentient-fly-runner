from pathlib import Path

ROOT = Path("sentient")

def replace_once(path: str, old: str, new: str) -> None:
    p = ROOT / path
    text = p.read_text()
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected one occurrence, found {count}: {old[:120]!r}")
    p.write_text(text.replace(old, new, 1))

replace_once(
    "src/spawn/selection.ts",
    '''    && (budget.maxTotalTokens === 0 || limits.totalTokens)
    && (budget.maxCostMicros === 0 || limits.costMicros)
    && (budget.maxRuntimeMs === 0 || limits.runtimeMs)''',
    '''    && (budget.maxTotalTokens === 0 || limits.totalTokens)
    // maxCostMicros is an inherited accounting/admission ceiling. Cloud providers
    // that truthfully cannot preempt on exact spend remain eligible; reported
    // spend is reconciled against the grant after execution. Callers that require
    // a provider-enforceable hard-dollar guarantee must express that explicitly
    // through targetPolicy.costRequirements matched against truthful costTags.
    && (budget.maxRuntimeMs === 0 || limits.runtimeMs)''',
)

replace_once(
    "src/application/production-mission-control-context.ts",
    '      inScope: ["mission", "broad relevant investigation"],',
    '      inScope: ["mission"],',
)

