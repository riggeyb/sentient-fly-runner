
  console.log(`${label}_PROVIDER_REQUEST_ID_PRESENT=${result.providerRequestId ? "true" : "false"}`);
  console.log(`ACTUAL_${label}_SMOKE_COST=${result.reportedCostUsd ?? "UNREPORTED"}`);
  return { ok: usageCaptured, auth: true, result };
}

const deepPrompts = [
  {
    label: "DEEPSEEK",
    prompt: 'Seven jobs A-G occupy slots 1-7. B is immediately after E. E precedes A. A precedes D. F is later than D. C is neither first nor last. G is later than B but earlier than F. D is not slot 6. Return JSON {"answer":"<first valid order>","checks":["..."]}.',
    maxOutputTokens: 320,
  },
  {
    label: "DEEPSEEK_RETRY",
    prompt: 'Eight jobs A-H occupy slots 1-8. B is immediately after E. E precedes A. A precedes D. F is later than D. C is neither first nor last. G is later than B but earlier than F. H is after C but before F. D is not slot 7. Return JSON {"answer":"<first valid order>","checks":["..."]}.',
    maxOutputTokens: 384,
  },
];

let deepSeek = null;
for (const p of deepPrompts) {
  deepSeek = await call(p.label, {
    model: DEEPSEEK_V3_2_MODEL_V1,
    systemPrompt: "Connectivity test only. You are non-authoritative. Reason carefully and independently cross-check the result. Return valid JSON and take no actions.",
    userPrompt: p.prompt,
    maxOutputTokens: p.maxOutputTokens,
    timeoutMs: 12_000,
    requireJsonObject: true,
    requiredTextValidator: (text) => text.includes("answer"),
  });
  if (!deepSeek?.ok || deepSeek.result.latencyMs > 8_000) break;
}
if (!deepSeek?.ok) throw new Error("deepseek_smoke_failed");
const deepLatency = deepSeek.result.latencyMs;
console.log(`DEEPSEEK_OLD_8S_THRESHOLD_EXCEEDED=${deepLatency > 8_000 ? "PASS" : "FAIL"}`)
