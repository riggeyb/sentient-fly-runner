replace_once(
    "src/model/providers/atlas-cloud-client.ts",
    '''    const timeoutSignal = AbortSignal.timeout(input.timeoutMs);''',
    '''    const conservativeInputTokens =
      Buffer.byteLength(input.systemPrompt, "utf8")
      + Buffer.byteLength(input.userPrompt, "utf8");
    if (
      input.maxInputTokens !== undefined
      && conservativeInputTokens > input.maxInputTokens
    ) {
      return this.#failure(
        model,
        "context_limit",
        "atlascloud_input_token_ceiling_exceeded_before_dispatch",
        started,
        null,
      );
    }
    const outputCeiling = input.maxTotalTokens === undefined
      ? input.maxOutputTokens
      : Math.min(input.maxOutputTokens, input.maxTotalTokens - conservativeInputTokens);
    if (outputCeiling <= 0) {
      return this.#failure(
        model,
        "context_limit",
        "atlascloud_total_token_ceiling_exhausted_before_dispatch",
        started,
        null,
      );
    }

    const timeoutSignal = AbortSignal.timeout(input.timeoutMs);''',
)
