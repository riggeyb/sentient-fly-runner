  ) reasons.push("caller_tier_claim_below_software_classification");
  if (request.maxAuthorizedTier < requiredTier) reasons.push("authority_tier_insufficient");
  if (!ID.test(request.authorizationIdentity.trim())) reasons.push("authorization_identity_invalid");
  if (!request.authorizationReason.trim()) reasons.push("authorization_reason_required");
  if (requiredTier >= 2) {
    const identity = request.identity;
    if (identity === undefined) reasons.push("exact_identity_required");
