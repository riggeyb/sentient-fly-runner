import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";

function read(path) { return readFileSync(path, "utf8"); }
function write(path, value) { writeFileSync(path, value); }
function replaceOnce(path, needle, replacement) {
  const source = read(path);
  const first = source.indexOf(needle);
  if (first < 0) throw new Error(`patch_missing:${path}:${needle.slice(0,80)}`);
  if (source.indexOf(needle, first + needle.length) >= 0) throw new Error(`patch_ambiguous:${path}:${needle.slice(0,80)}`);
  write(path, source.slice(0, first) + replacement + source.slice(first + needle.length));
}
function writeNew(path, value) {
  if (existsSync(path)) throw new Error(`patch_target_exists:${path}`);
  const slash = path.lastIndexOf("/");
  if (slash >= 0) mkdirSync(path.slice(0, slash), { recursive: true });
  write(path, value);
}

