        request.actionType === "engineering_job_create"
        || request.actionType === "source_mutation"
        || request.actionType === "source_merge"
        || request.actionType === "governor_deployment"
        || request.actionType === "production_environment_mutation"
        || request.actionType === "production_database_mutation"
        || request.actionType === "model_promotion"
        || request.actionType === "policy_modification"
      ) {
        if (!exactSource && !exactRuntime) reasons.push("exact_source_or_runtime_identity_required");
      }
    }
  }
  if (requiredTier === 4 && request.separateAuthority !== true) {
    reasons.push("separate_authority_required");
  }
  return Object.freeze({
    allowed: reasons.length === 0,
    requiredTier,
    policyVersion: CAPABILITY_TIER_POLICY_VERSION,
    reasonCodes: Object.freeze(reasons.length === 0 ? ["allowed"] : reasons),
  });
}

