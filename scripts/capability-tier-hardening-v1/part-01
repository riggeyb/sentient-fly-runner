]);

function normalizedToken(value: string): string {
  return value.trim().toLowerCase().replace(/[\\s./:-]+/g, "_");
}

export function capabilityTierForEffectTokenV1(value: string): CapabilityTierV1 {
  const token = normalizedToken(value);
  if (TIER_4_TOKENS.has(token)) return 4;
  if (TIER_3_TOKENS.has(token)) return 3;
  if (TIER_2_TOKENS.has(token)) return 2;
  if (TIER_1_TOKENS.has(token)) return 1;
  return 0;
}

export function requestedEffectTierV1(input: {
  capabilities?: readonly string[];
  tools?: readonly { toolId: string; capabilities: readonly string[]; scope: readonly string[] }[];
  repositoryWritePaths?: readonly string[];
  repositoryOperations?: readonly string[];
}): CapabilityTierV1 {
  const tokens = [
    ...(input.capabilities ?? []),
    ...(input.tools ?? []).flatMap((tool) => [tool.toolId, ...tool.capabilities, ...tool.scope]),
    ...(input.repositoryOperations ?? []),
  ];
  const tokenTier = tokens.reduce<CapabilityTierV1>(
    (tier, token) => maxCapabilityTierV1(tier, capabilityTierForEffectTokenV1(token)),
    0,
  );
  return (input.repositoryWritePaths?.length ?? 0) > 0
    ? maxCapabilityTierV1(tokenTier, 2)
    : tokenTier;
}

export function normalizeAuthorizedSourcePathV1(value: string): string {
  const normalized = value.trim().replaceAll("\\\\", "/").replace(/^\\.\\/+/, "").replace(/\\/+/g, "/");
  if (
    !PATH.test(normalized)
    || normalized.startsWith("/")
    || normalized === "."
    || normalized === ".."
    || normalized.split("/").includes("..")
    || normalized.endsWith("/")
    || normalized.includes("*")
  ) throw new Error("engineering_authorized_path_invalid");
  return normalized;
}

