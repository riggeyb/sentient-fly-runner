    || path.startsWith("src/deployment-governor/")
    || PROTECTED_EXACT.has(path);
}

export function assertOrdinarySourceMutationScopeV1(paths: readonly string[]): readonly string[] {
  if (paths.length < 1 || paths.length > 64) throw new Error("engineering_authorized_paths_must_have_1_to_64_entries");
  const normalized = [...new Set(paths.map(normalizeAuthorizedSourcePathV1))].sort();
  if (normalized.length !== paths.length) throw new Error("engineering_authorized_paths_must_be_unique");
  const protectedPath = normalized.find(isProtectedPolicyPathV1);
  if (protectedPath !== undefined) {
    throw new Error(\`REJECTED_REQUIRES_SEPARATE_AUTHORITY:protected_policy_path:\${protectedPath}\`);
  }
  return Object.freeze(normalized);
}

export function assertChangedPathsAuthorizedV1(
  changedPaths: readonly string[],
  authorizedPaths: readonly string[],
): void {
  const allowed = new Set(authorizedPaths.map(normalizeAuthorizedSourcePathV1));
  for (const raw of changedPaths) {
    const path = normalizeAuthorizedSourcePathV1(raw);
    if (isProtectedPolicyPathV1(path)) {
      throw new Error(\`REJECTED_REQUIRES_SEPARATE_AUTHORITY:protected_policy_path:\${path}\`);
    }
    if (!allowed.has(path)) throw new Error(\`engineering_changed_path_not_authorized:\${path}\`);
  }
}
