const TIER_3_TOKENS = new Set([
  "deploy", "deployment", "production_deploy", "production_mutation", "production_environment_mutation",
  "production_database_mutation", "model_promotion", "activate_model",
]);
const TIER_2_TOKENS = new Set([
  "write", "edit", "source_write", "source_mutation", "source_merge", "engineering_job", "commit", "push",
]);
const TIER_1_TOKENS = new Set([
