TierV1>((max, tier) => tier > max ? tier : max, 0);
}

const TIER_4_TOKENS = new Set([
  "paid_compute", "paid_compute_enablement", "gpu", "gpu_enable", "resize", "resource_change",
  "resource_increase", "delete", "artifact_delete", "retention_pin_remove", "policy_change",
