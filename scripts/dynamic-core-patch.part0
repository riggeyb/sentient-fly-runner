
from pathlib import Path

def write(path, text):
    Path(path).write_text(text)

def replace(path, old, new, count=1):
    p=Path(path)
    s=p.read_text()
    actual=s.count(old)
    if actual != count:
        raise SystemExit(f"{path}: expected {count} occurrences, found {actual}: {old[:100]!r}")
    p.write_text(s.replace(old,new,count))

