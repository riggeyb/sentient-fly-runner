'''function normalizedPolicyId(policy: Phase1AcceptancePolicyV1): string | null {''',
r'''const PHASE1_LATE_RESULT_V1 = Symbol("phase1-late-result");

async function awaitLivePhase1ResultV1(
  pending: Promise<ModelResult | unknown>,
  control: Phase1InvocationControlV1,
): Promise<ModelResult | unknown | typeof PHASE1_LATE_RESULT_V1> {
  if (control.signal.aborted || Date.now() >= control.absoluteDeadlineMs) return PHASE1_LATE_RESULT_V1;
  return await new Promise((resolve, reject) => {
    let settled = false;
    const remaining = Math.max(1, control.absoluteDeadlineMs - Date.now());
    const finish = (value: ModelResult | unknown | typeof PHASE1_LATE_RESULT_V1, failed = false) => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      control.signal.removeEventListener("abort", onAbort);
      failed ? reject(value) : resolve(value);
    };
    const onAbort = () => finish(PHASE1_LATE_RESULT_V1);
    const timer = setTimeout(onAbort, remaining);
    control.signal.addEventListener("abort", onAbort, { once: true });
    pending.then(
      (value) => {
        if (control.signal.aborted || Date.now() >= control.absoluteDeadlineMs) {
          finish(PHASE1_LATE_RESULT_V1);
        } else {
          finish(value);
        }
      },
      (error) => finish(error, true),
    );
  });
}

function normalizedPolicyId(policy: Phase1AcceptancePolicyV1): string | null {''')

