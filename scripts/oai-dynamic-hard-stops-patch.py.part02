ilure("failed", "atlas_hybrid_terminal_unavailable");',
)
with Path(p).open("a") as f:
    f.write(r'''
function constraintNumber(requirements: TaskRequirementsV1, key: string): number | null {
  const value = requirements.constraints[key];
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
}
function phase1HardStopFailure(reason: string, telemetry: readonly HybridModelTelemetryV1[] = []) {
  return {
    ok: false,
    provider: "sentient-hybrid",
    model: "asymmetric-atlas-local-v1",
    code: "provider_error",
    message: reason,
    retryable: false,
    latencyMs: totalLatency(telemetry),
    metadata: {
      modelOutputIsAuthority: false,
      terminalUnavailable: true,
      lateOutputRejected: reason === "late_model_output_rejected",
      telemetry: jsonValue(telemetry),
    },
  };
}
''')

p = "src/phase1/core-runtime.ts"
replace_once(
    p,
    '''export interface ExecutePhase1TurnOptions {
  cognition?: Phase1CognitionPort | null;
  acceptancePolicy?: Phase1AcceptancePolicyV1 | null;
}''',
    '''export interface ExecutePhase1TurnOptions {
  cognition?: Phase1CognitionPort | null;
  acceptancePolicy?: Phase1AcceptancePolicyV1 | null;
  additionalConstraints?: Readonly<Record<string, string | number | boolean>>;
}''',
)
replace_once(
    p,
    '''    constraints: Object.freeze({
      maxToolCalls: 0,
      maxDelegatedSubtasks: 0,
      deterministicPresentationRequired: true,
    }),''',
    '''    constraints: Object.freeze({
      maxToolCalls: 0,
      maxDelegatedSubtasks: 0,
      deterministicPresentationRequired: true,
      ...(options.additionalConstraints ?? {}),
    }),''',
)
