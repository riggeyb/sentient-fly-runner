ilure("failed", "atlas_hybrid_terminal_unavailable");',
)
with Path(p).open("a") as f:
    f.write(r'''
function constraintNumber(requirements: TaskRequirementsV1, key: string): number | null {
  const value = requirements.constraints[key];
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
}
function phase1HardStopFailure(reason: string, telemetry: readonly HybridModelTelemetryV1[] = []) {
  return {
    ok: false,
    provider: "sentient-hybrid",
    model: "asymmetric-atlas-local-v1",
    code: "provider_error",
    message: reason,
    retryable: false,
    latencyMs: totalLatency(telemetry),
    metadata: {
      modelOutputIsAuthority: false,
      terminalUnavailable: true,
      lateOutputRejected: reason === "late_model_output_rejected",
      telemetry: jsonValue(telemetry),
    },
  };
}
''')

p = "src/spawn/orchestrator.ts"
replace_once(
    p,
    '''      const result = await backend.execute({
        identity,
        taskPackage,
        target: selected.target,
        signal: input.signal,
      });''',
    '''      const runtimeSignal = AbortSignal.timeout(taskPackage.effectiveGrant.budgets.maxRuntimeMs);
      const executionSignal = AbortSignal.any([input.signal, runtimeSignal]);
      const result = await backend.execute({
        identity,
        taskPackage,
        target: selected.target,
        signal: executionSignal,
      });
      const liveResult = executionSignal.aborted
        ? {
            status: "timed_out" as const,
            output: null,
            artifactRefs: [],
            evidenceRefs: [],
            toolActions: [],
            usage: { costMicros: 0, toolRounds: 0, toolActions: 0 },
            costMicros: 0,
            failure: { class: "timeout", message: "late_model_output_rejected", retryable: false },
            unresolvedAmbiguities: [],
          }
        : result;''',
)
# Replace references in the block between backend result and verification decision.
s = Path(p).read_text()
anchor = "      const liveResult = executionSignal.aborted"
a = s.index(anchor)
b = s.index("      const verification =", a)
segment = s[a:b].replace("result.", "liveResult.").replace("(result)", "(liveResult)")
Path(p).write_text(s[:a] + segment + s[b:])

p = "src/phase1/core-runtime.ts"
replace_once(
    p,
    '''export interface ExecutePhase1TurnOptions {
  cognition?: Phase1CognitionPort | null;
  acceptancePolicy?: Phase1AcceptancePolicyV1 | null;
}''',
    '''export interface ExecutePhase1TurnOptions {
  cognition?: Phase1CognitionPort | null;
  acceptancePolicy?: Phase1AcceptancePolicyV1 | null;
  additionalConstraints?: Readonly<Record<string, string | number | boolean>>;
}''',
)
replace_once(
    p,
    '''    constraints: Object.freeze({
      maxToolCalls: 0,
      maxDelegatedSubtasks: 0,
      deterministicPresentationRequired: true,
    }),''',
    '''    constraints: Object.freeze({
      maxToolCalls: 0,
      maxDelegatedSubtasks: 0,
      deterministicPresentationRequired: true,
      ...(options.additionalConstraints ?? {}),
    }),''',
)
