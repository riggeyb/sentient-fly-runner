from pathlib import Path

def replace_once(path: str, old: str, new: str, label: str) -> None:
    p = Path(path)
    text = p.read_text()
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{label}: expected one match, got {count}")
    p.write_text(text.replace(old, new, 1))

replace_once(
    "src/deployment-governor/fly-exec.ts",
    '  public async waitReady(candidate: SentientCandidateDeploymentInput): Promise<HttpProbeEvidence> {\n    const deadline = Date.now() + 90_000;',
    '  public async waitReady(\n    candidate: SentientCandidateDeploymentInput,\n    timeoutMs = 90_000,\n  ): Promise<HttpProbeEvidence> {\n    const deadline = Date.now() + timeoutMs;',
    "waitReady optional timeout",
)

for path in ["test/atlas-hybrid-router.test.ts", "test/dynamic-hard-stops-core.test.ts"]:
    p = Path(path)
    s = p.read_text()
    if "ATLAS_CLOUD_ATTEMPT_TIMEOUT_MS_V1" not in s:
        raise SystemExit(f"{path}: generic timeout import/use missing")
    s = s.replace("ATLAS_CLOUD_ATTEMPT_TIMEOUT_MS_V1", "DEEPSEEK_COGNITION_TIMEOUT_MS_V1")
    p.write_text(s)

print("stage-a compatibility tail applied")
