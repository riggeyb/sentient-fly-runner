
from pathlib import Path

def replace_once(path, old, new):
    p=Path(path); s=p.read_text()
    n=s.count(old)
    if n!=1: raise SystemExit(f"{path}: expected 1 match, got {n}: {old[:120]!r}")
    p.write_text(s.replace(old,new,1))

