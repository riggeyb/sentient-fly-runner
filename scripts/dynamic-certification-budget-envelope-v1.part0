replace_once("src/model/providers/atlas-cloud-client.ts",
'''    const timeoutSignal = AbortSignal.timeout(input.timeoutMs);''',
'''    // Tokenizers differ by provider. UTF-8 bytes plus a fixed chat-envelope allowance
    // is a conservative upper bound used only to reject before network dispatch.
    const conservativeInputUpperBound =
      Buffer.byteLength(input.systemPrompt, "utf8")
      + Buffer.byteLength(input.userPrompt, "utf8")
      + 64;
    if (
      input.maxInputTokens !== undefined
      && conservativeInputUpperBound > input.maxInputTokens
    ) {
      return this.#failure(model, "context_limit", "atlascloud_input_token_ceiling_exceeded_before_dispatch", started, null);
    