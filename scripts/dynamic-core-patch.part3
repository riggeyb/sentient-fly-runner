replace("src/model/providers/atlas-hybrid-adapters.ts",
'''  public async run(requirements: TaskRequirementsV1): Promise<unknown> {
    const result = this.#stage === "synthesis"
      ? await this.#router.synthesis({
          systemPrompt: "Synthesize only from supplied accepted and verified context. Never invent effects or authority.",
          userPrompt: requirements.normalizedUserRequest,
          maxInputTokens: 8_192,
          maxOutputTokens: 1_024,
        })
      : await this.#router.cognition({
          systemPrompt: "Analyze intent, decompose tasks, plan, and propose a bounded candidate answer.",
          userPrompt: requirements.normalizedUserRequest,
          maxInputTokens: 4_096,
          maxOutputTokens: 384,
        });''',
'''  public async run(
    requirements: TaskRequirementsV1,
    control?: Phase1InvocationControlV1,
  ): Promise<unknown> {
    const remaining = control === undefined
      ? undefined
      : Math.max(1, control.absoluteDeadlineMs - Date.now());
    const common = {
      ...(control?.maxCostMicros === undefined ? {} : { maxCostMicros: control.maxCostMicros }),
      ...(remaining === undefined ? {} : { timeoutMs: remaining }),
      ...(control?.signal === undefined ? {} : { signal: control.signal }),
    };
    const result = this.#stage === "synthesis"
      ? await this.#router.synthesis({
          systemPrompt: "Synthesize only from supplied accepted and verified context. Never invent effects or authority.",
          userPrompt: requirements.normalizedUserRequest,
          maxInputTokens: Math.min(8_192, control?.maxInputTokens ?? 8_192),
          maxOutputTokens: Math.min(1_024, control?.maxOutputTokens ?? 1_024),
          ...common,
        })
      : await this.#router.cognition({
          systemPrompt: "Analyze intent, decompose tasks, plan, revise, critique, and propose bounded candidate results. Human intent is immutable and effect authority never expands.",
          userPrompt: requirements.normalizedUserRequest,
          maxInputTokens: Math.min(4_096, control?.maxInputTokens ?? 4_096),
          maxOutputTokens: Math.min(512, control?.maxOutputTokens ?? 512),
          ...common,
        });''')
