    privacyPolicy: {
      classification: "private",
      allowedDataHandlingModes: ["atlascloud-openai-compatible", "local-process"],
      allowExternalProcessing: true,
    },
  } as never;
}

const grant = {
  targetConstraints: {
    targets: { allowed: [], denied: [] },
    backends: { allowed: [], denied: [] },
    providers: { allowed: [], denied: [] },
    models: { allowed: [], denied: [] },
    preferenceOrder: [],
  },
} as never;

test("normal inherited cost accounting ceiling keeps truthful Atlas hybrid eligible", async () => {
  const [atlas] = await new AtlasHybridSpawnExecutionBackendV1(null as never).describe();
  assert.ok(atlas);
  assert.equal(atlas.hardLimitEnforcement.costMicros, false);
  const inspected = inspectSpawnTargetEligibilityV1(request(), grant, atlas);
  assert.equal(inspected.eligible, true);
  assert.equal(inspected.reasonCodes.includes("hard_limit_unenforceable"), false);
});

