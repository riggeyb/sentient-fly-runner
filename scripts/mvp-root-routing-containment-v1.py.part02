function request(costRequirements: string[] = []) {
  return {
    budgets: {
      maxInputTokens: 4_096,
      maxOutputTokens: 512,
      maxTotalTokens: 4_608,
      maxCostMicros: 25_000,
      currency: "USD",
      maxRuntimeMs: 45_000,
      maxToolRounds: 0,
      maxToolActions: 0,
      maxChildExecutions: 0,
      maxRecursionDepth: 0,
    },
    targetPolicy: {
      requiredCapabilities: ["objective.cognition"],
      qualityRequirements: [],
      costRequirements,
      privacyRequirements: ["private"],
