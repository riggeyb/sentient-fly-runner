  "artifactSchemaVersion": "sentient-cognition-artifact/v1",
  "modelNeutral": true,
  "privateChainOfThoughtRequired": false,
  "purpose": "Model-neutral cognition-to-Dots3 synthesis handoff carrying externally useful reasoning products only.",
  "schemaVersion": "sentient-cognition-artifact-contract/v1",
  "tokenAccounting": {
    "reportedReasoningTokens": "record separately when provider reports them",
    "totalBilledOutputTokens": "record provider completion/output tokens separately; do not equate them with visible artifact length",
    "visibleArtifact": "record exact UTF-8 bytes and a model-neutral estimate ceil(bytes/4); do not present the estimate as tokenizer-exact"
  },
  "visibleOutputPolicy": {
    "absoluteMaxTokens": 2000,
    "high": {
      "targetMaxTokens": 2000,
      "targetMinTokens": 1200
    },
    "low": {
      "targetMaxTokens": 750,
      "targetMinTokens": 500
    },
    "minimumIsPaddingTarget": false,
    "rule": "Shorter complete artifacts are preferred over padding. Increase allowance when compression would lose critical evidence, constraints, uncertainty, causal relationships, tool rationale, or verification needs.",
    "standard": {
      "targetMaxTokens": 1200,
      "targetMinTokens": 750
    }
  }
}
