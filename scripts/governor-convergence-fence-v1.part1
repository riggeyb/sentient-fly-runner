'''function imageReference(value: unknown): string | null {
  if (typeof value === "string" && value.trim()) return value.trim();
  const row = record(value);
  const direct = text(row.ref ?? row.reference ?? row.image);
  if (direct) return direct;
  const repository = text(row.repository ?? row.repo);
  const registry = text(row.registry);
  const tag = text(row.tag);
  const digest = text(row.digest);
  if (!repository) return null;
  const base = registry && !repository.startsWith(`${registry}/`) ? `${registry}/${repository}` : repository;
  const tagged = tag ? `${base}:${tag}` : base;
  return digest ? `${tagged}@${digest.startsWith("sha256:") ? digest : `sha256:${digest}`}` : tagged;
}

