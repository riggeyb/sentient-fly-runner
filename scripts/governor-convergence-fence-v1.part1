): FlyMachineConvergenceEvidence {
  const root = record(value);
  const nested = record(root.machine);
  const machine = Object.keys(nested).length > 0 ? nested : root;
  const config = record(machine.config);
  const state = text(machine.state ?? machine.State);
  const rawVersion = machine.version ?? machine.Version ?? machine.current_version ?? machine.currentVersion;
  const version = typeof rawVersion === "number" || typeof rawVersion === "string" ? String(rawVersion).trim() || null : null;
  const imageRef = imageReference(machine.image_ref ?? machine.imageRef ?? config.image ?? machine.image);
  const expected = `registry.fly.io/${SENTIENT_DEPLOYMENT_APP}:phase0-${candidate.sha}`;
  const imageMatches = imageRef === expected || imageRef?.startsWith(`${expected}@sha256:`) === true;
  const running = state === "started" || state === "running";
  return {
    ok: running && version !== null && imageMatches,
    reason: !running ? `candidate_machine_not_running:${state ?? "unknown"}`
      : version === null ? "candidate_machine_version_unavailable"
      : !imageMatches ? `candidate_machine_image_mismatch:${imageRef ?? "unknown"}` : null,
    machineId: text(machine.id ?? machine.ID),
    state,
    version,
    imageRef,
  };
}

